# MeisterAI Daily-Fast config — copy to ~/.meister/config (merge keys)
# Full weekly run: MeisterAI --deep

# Profiles (CLI overrides this): auto | quick | deep
# RUN_PROFILE=auto

# Homebrew: skip update if last run was within 12 hours (0 = always update)
BREW_UPDATE_MAX_AGE_SEC=43200
BREW_UPDATE_TIMEOUT_SEC=300
BREW_UPGRADE_TIMEOUT_SEC=600
# Cask upgrade: not --greedy on daily auto (Word/WhatsApp hang). --deep enables greedy.
# BREW_CASK_GREEDY=false
# BREW_CASK_TIMEOUT_SEC=180
# BREW_PKG_TIMEOUT_SEC=180        # per-formula timeout; live [i/n] START/DONE
# BREW_CASK_SKIP="whatsapp microsoft-word"
FIND_TIMEOUT_SEC=60

# Heavy modules off for daily (enable with --deep)
UNIVERSAL_UPDATES=false
ICLOUD_FIX_ENABLED=false
ICLOUD_STUBS_SCAN=false
DOCS_ORDER_DATALESS_SCAN=false
SELFHEAL_ICLOUD_CONTAINERS=false
SECURITY_PERSISTENCE_AUDIT=false
SECURITY_TCC_AUDIT=false
CLEAN_DOCKER=false
SELFHEAL_GIT_AUTOCOMMIT=false
GIT_AUTO_PUSH=false
# Autofix git push is also gated by GIT_AUTO_PUSH (both must be true).
# AUTOFIX_GIT_PUSH=true
# AufRaum: _Inbox dry-run during docs-order. Live sort only if:
# AUFRAUM_APPLY=false
# AUFRAUM_OPERATOR=$HOME/.grok/skills/aufraum/scripts/aufraum.py

# AI transparency (false = less terminal noise)
# AI_TRACE=true

# AI-Heal execute gate — default ON (allowlisted cmds run + verify-after-heal).
# Opt-out: AI_HEAL_EXECUTE=false or --ai-heal-suggest
AI_HEAL_EXECUTE=true

# v6.13 run budget (soft)
# RUN_MAX_SEC=1200          # skip remaining modules after 20 min wall clock
# MODULE_SLOW_SEC=300       # WARN if one module exceeds 5 min
# MEISTER_NOTIFY=true       # notification after run (already default)

# Unattended confirmations (default true): y/N is yes; no TTY never waits.
# MEISTER_ALWAYS_YES=true

# v6.17 Touch ID for sudo (default true — auto pam_tid in /etc/pam.d/sudo_local)
# One password once to enable; afterwards fingerprint. Opt-out:
# TOUCHID_SUDO=false

# Fleet (optional)
# FLEET_HOSTS="mac-mini.local"

# Structured FM diagnoses: system | auto | pcc
# auto starts on-device; unresolved complete evidence can escalate to PCC.
# system keeps all inference on-device. PCC receives bounded, redacted context.
# FM_HEAL_MODEL=auto
# FM_DIAGNOSE_MODEL=system
# Actions are fixed catalog IDs; AI_HEAL_EXECUTE remains the execution gate.

# meister / Ollama: explicit model, bounded generation, reuse loaded weights.
# No automatic downloads or silent model fallback.
MEISTER_OLLAMA_URL="http://localhost:11434"
MEISTER_OLLAMA_MODEL="qwen3-coder:30b"
MEISTER_OLLAMA_TIMEOUT=90
MEISTER_OLLAMA_KEEP_ALIVE="5m"
MEISTER_OLLAMA_NUM_CTX=8192
MEISTER_OLLAMA_NUM_PREDICT=1024

# Bounded diagnostics need the final answer, not an internal reasoning trace.
MEISTER_OLLAMA_THINK="false"
